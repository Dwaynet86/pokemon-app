# Copy to .env and adjust.
# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pokemon

# Photo identification uses the free TCG Tracking scan API (no key needed).
# TCGTRACKING_GAME_ID=3     # 3 = Pokemon
# SCAN_MIN_SCORE=50         # a weaker match than this % is retried (upside down, then uncropped)

# Prices come from TCGdex (no key). PokeWallet is an optional fallback for cards TCGdex has no price for
# (https://pokewallet.io, free plan: 100 requests/hour).
# Artwork for cards TCGdex has no picture for: URL templates tried in order, comma-separated.
# Placeholders: {set_id} {local_id} {number}. Empty turns the fallback off.
# ART_FALLBACK_URLS=https://images.pokemontcg.io/{set_id}/{number}_hires.png
# ART_RETRY_MINUTES=30

# PRICE_MAX_AGE_HOURS=24
# PRICE_FALLBACK_MAX=15
POKEWALLET_API_KEY=

# TCGDEX_LANG=en          # one language for the whole app (card text and artwork)
# SYNC_WORKERS=4          # parallel downloads while saving an expansion locally
# UPLOAD_DIR=./uploads    # the local artwork cache (+ photos, briefly, while you confirm a card)
# Set to 1 only when served over HTTPS:
# SESSION_COOKIE_SECURE=1
